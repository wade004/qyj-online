    "test": "node test/audio.mjs && node test/poker_rules.mjs && node test/dynamic-seats.mjs && node test/advisor.mjs && node test/h5_hand_feedback.mjs && node test/skills.mjs && node test/training_rules.mjs && node test/observation.mjs && node test/opponent-range.mjs && node test/blueprint-policy.mjs && node test/blueprint-residual-policy.mjs && node test/blueprint-training.mjs && node test/blueprint-cli.mjs && node test/blueprint-curriculum.mjs && node test/blueprint-coverage.mjs && node test/blueprint-targeted.mjs && node test/ai_advanced.mjs && node test/account_client.mjs && node test/battle_session.mjs && node test/mp_smoke.mjs"
